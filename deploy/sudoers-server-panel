# /etc/sudoers.d/server-panel — whitelist для веб-панели (пользователь panel).
# Только конкретные команды; никакого NOPASSWD: ALL. Источник: /opt/server-panel/deploy/sudoers-server-panel
# Проверка перед установкой: visudo -cf <файл>

# Этап 2: SMART (без пробуждения спящих дисков), чтение crontab, управление службами из белого списка
Cmnd_Alias SP_SMART = /usr/sbin/smartctl -j -a -n standby /dev/sd[a-z]
Cmnd_Alias SP_CRONTAB = /usr/bin/crontab -l -u root, /usr/bin/crontab -l -u hawk, /usr/bin/crontab -l -u macmini
Cmnd_Alias SP_UNITS = /usr/bin/systemctl start nginx.service, \
    /usr/bin/systemctl stop nginx.service, \
    /usr/bin/systemctl restart nginx.service, \
    /usr/bin/systemctl start php8.3-fpm.service, \
    /usr/bin/systemctl stop php8.3-fpm.service, \
    /usr/bin/systemctl restart php8.3-fpm.service, \
    /usr/bin/systemctl start mariadb.service, \
    /usr/bin/systemctl stop mariadb.service, \
    /usr/bin/systemctl restart mariadb.service, \
    /usr/bin/systemctl start mongod.service, \
    /usr/bin/systemctl stop mongod.service, \
    /usr/bin/systemctl restart mongod.service, \
    /usr/bin/systemctl start smbd.service, \
    /usr/bin/systemctl stop smbd.service, \
    /usr/bin/systemctl restart smbd.service, \
    /usr/bin/systemctl start nmbd.service, \
    /usr/bin/systemctl stop nmbd.service, \
    /usr/bin/systemctl restart nmbd.service, \
    /usr/bin/systemctl start xrdp.service, \
    /usr/bin/systemctl stop xrdp.service, \
    /usr/bin/systemctl restart xrdp.service, \
    /usr/bin/systemctl start fail2ban.service, \
    /usr/bin/systemctl stop fail2ban.service, \
    /usr/bin/systemctl restart fail2ban.service, \
    /usr/bin/systemctl start triggerhappy.service, \
    /usr/bin/systemctl stop triggerhappy.service, \
    /usr/bin/systemctl restart triggerhappy.service, \
    /usr/bin/systemctl start alert_monitor.service, \
    /usr/bin/systemctl stop alert_monitor.service, \
    /usr/bin/systemctl restart alert_monitor.service, \
    /usr/bin/systemctl start pulsdev-api.service, \
    /usr/bin/systemctl stop pulsdev-api.service, \
    /usr/bin/systemctl restart pulsdev-api.service, \
    /usr/bin/systemctl start thermal-watchdog.service, \
    /usr/bin/systemctl stop thermal-watchdog.service, \
    /usr/bin/systemctl restart thermal-watchdog.service, \
    /usr/bin/systemctl start mbpfan.service, \
    /usr/bin/systemctl stop mbpfan.service, \
    /usr/bin/systemctl restart mbpfan.service, \
    /usr/bin/systemctl start smartmontools.service, \
    /usr/bin/systemctl stop smartmontools.service, \
    /usr/bin/systemctl restart smartmontools.service, \
    /usr/bin/systemctl start cron.service, \
    /usr/bin/systemctl stop cron.service, \
    /usr/bin/systemctl restart cron.service, \
    /usr/bin/systemctl start ollama.service, \
    /usr/bin/systemctl stop ollama.service, \
    /usr/bin/systemctl restart ollama.service

# Этап 3: размер журнала запросов AdGuard (файл в volume Docker, только root)
Cmnd_Alias SP_ADGUARD = /usr/bin/stat -c %s /var/lib/docker/volumes/adguardhome_work/_data/data/querylog.json

# Монтирование съёмных дисков из раздела «Диски»: только точные команды (без шаблонов)
Cmnd_Alias SP_MOUNT = /usr/bin/mount /mnt/hdd1tb, /usr/bin/mount /mnt/uploads1, /usr/bin/mount /mnt/uploads2, \
    /usr/bin/umount -l /mnt/hdd1tb, /usr/bin/umount -l /mnt/uploads1, /usr/bin/umount -l /mnt/uploads2

# Bluetooth из раздела «Беспроводные»: только точные команды bluetoothctl
Cmnd_Alias SP_BT = /usr/bin/bluetoothctl power on, /usr/bin/bluetoothctl power off, /usr/bin/bluetoothctl --timeout 20 scan on

panel ALL=(root) NOPASSWD: SP_SMART, SP_CRONTAB, SP_UNITS, SP_ADGUARD, SP_MOUNT, SP_BT

# Этап 4: последние изменённые записи WordPress зеркала — WP-CLI от www-data, одна фиксированная команда
# (wp-config.php читает только www-data; любые другие аргументы wp запрещены)
Cmnd_Alias SP_WPCLI = /usr/local/bin/wp --path\=/var/www/www/jetsetter.ua --skip-plugins --skip-themes post list --post_type\=post\,page --orderby\=modified --order\=DESC --posts_per_page\=15 --fields\=ID\,post_title\,post_type\,post_status\,post_modified --format\=json
panel ALL=(www-data) NOPASSWD: SP_WPCLI

# Этап 5: SSH и доступ — одна root-утилита со строгой проверкой команд и аргументов
# (authorized_keys, ufw deny, fail2ban ban/unban, завершение SSH/RDP-сессий, ssh stop/start, wg show без приватного ключа).
# Утилита: /usr/local/sbin/server-panel-helper (root:root 755), источник — /opt/server-panel/deploy/server-panel-helper
panel ALL=(root) NOPASSWD: /usr/local/sbin/server-panel-helper
