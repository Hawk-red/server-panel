# /etc/mount-guard.conf — настройки сторожа монтирования (подключается как bash-файл, владелец root).
# Любую строку можно закомментировать — тогда действует значение по умолчанию из скрипта.

# Сколько секунд ждать появления USB-дисков и успешного mount (потом — событие mount.failed).
WAIT_SECONDS=180
# Пауза между попытками.
RETRY_INTERVAL=5
# Таймаут одного вызова mount (зависший USB не должен держать сторож бесконечно).
MOUNT_TIMEOUT=60

# Запускать ли контейнеры, упавшие при старте из-за отсутствия диска (State.Error: «mount request» /
# «no such file or directory»). По умолчанию НЕТ: только лог и уведомление, запуск — вручную (docker start …).
# Поставьте yes, когда будете уверены; тогда сторож запустит только такие контейнеры и только через docker start.
# Учтите: cron-сторож обменника ~/Scripts/sftpgo-guard.sh сам запускает sftpgo раз в минуту, как только диск смонтирован.
AUTO_START_CONTAINERS=no

# Какие контейнеры проверять после монтирования hdd1tb.
CONTAINERS="qbittorrent sftpgo"

# yes — писать события в лог для панели (Telegram); no — только обычный лог.
NOTIFY=yes
